# ---------------------------------------------------------------------------
# Bagimliliklar ve build ciktilari
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/

# ---------------------------------------------------------------------------
# Ortam degiskenleri - .env.example haric hicbiri repoya girmez
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Kisisel calisma dosyalari
#
# notes/ repoya asla girmez: CV notlari, is gecmisi kaynaklari, ic degerlendirme
# ve acik guvenlik bulgulari icerir. Icerikleri (varsa) elle ExperiencePage.jsx
# veya backend/data/*.md dosyalarina aktarilir.
# ---------------------------------------------------------------------------
notes/

# Ayni dosyalar yanlislikla baska bir dizine kopyalanirsa yine yakalansin diye
# isim bazli ikinci emniyet katmani.
cv.pdf
scaleaiproject.md
yapilacaklar.md

# Eval/test ciktilari: uretilen cevaplar kisisel bilgi icerebilir (bir kez
# .rag_test_results.json olarak repoya sizmisti).
.rag_test_results.json
*_test_results.json

# ---------------------------------------------------------------------------
# Editor ve isletim sistemi
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Gecici dosyalar
# ---------------------------------------------------------------------------
*.log
*.tmp
