OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=documents
SUPABASE_QUERY_NAME=match_documents

# Chat memory + log DB (asyncpg). Prod'da Coolify içindeki chatlogs-db Postgres'i.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Calisma modu: local | prod   (varsayilan: prod)
#   prod  -> normal davranis; DATABASE_URL zorunlu, mesajlar DB'ye yazilir.
#            Coolify'da MODE=prod olarak set edilir.
#   local -> DB'ye hicbir sey yazilmaz; prod verisi kirlenmez.
# Tanimlanmazsa prod kabul edilir; DATABASE_URL eksikse uygulama startup'ta durur.
MODE=local

HISTORY_LIMIT=10
RETRIEVER_K=12
RERANK_TOP_N=8
# Rerank eşiği sabit bir sayı değil: cutoff = max(RERANK_ABS_FLOOR, top1 * RERANK_REL_RATIO)
#
# Eski RERANK_MIN_SCORE=0.3 kaldırıldı. Kalibrasyonu (19.07.2026: negatifler ≤0.225,
# pozitifler ≥0.400) golden.yaml'ın TAM CÜMLE sorularıyla yapılmıştı ve o sorgular için
# doğruydu. Agent tool'a kısa keyword gönderdiğinde aynı chunk 0.09 alıyor ("hobiler" →
# 0.09, "Yasin'in hobileri neler?" → 0.99), yani gerçek pozitif negatiflerin de altına
# düşüyor ve sabit eşik her şeyi eliyordu.
#
# 0.4 oranı kalibrasyonu korur: top1≈0.99 olan iyi bir sorguda cutoff≈0.40 çıkar, yani
# negatifler (≤0.225) yine kesilir. Bozuk sorguda ise eşik dağılımla birlikte iner.
RERANK_REL_RATIO=0.4
# Eşiğin inebileceği taban. top1 bunun da altındaysa hiçbir şey geçemez; o durumda
# boş dönmek yerine en iyi RERANK_FALLBACK_N chunk döner ve iz fallback_used işaretlenir.
RERANK_ABS_FLOOR=0.15
RERANK_FALLBACK_N=3
# match_documents RPC'sine geçilen cosine similarity tabanı (0 = kapalı; RPC 4-arg imzayı gerektirir)
MATCH_THRESHOLD=0.0

CHUNK_SIZE=2000
CHUNK_OVERLAP=150

MAX_INPUT_LENGTH=1000
# /chat auth'suz ve halka açık; her istek 2-5 OpenAI + 2-5 Cohere çağrısı demek.
RATE_LIMIT_PER_MIN=20    # IP başına (X-Forwarded-For'un SON elemanı)
RATE_LIMIT_PER_DAY=100   # session_id başına

ADMIN_API_KEY=change-me
ALLOWED_ORIGINS=https://yasinharman.com,https://www.yasinharman.com,http://localhost:5173

PORT=8000
LOG_LEVEL=info
