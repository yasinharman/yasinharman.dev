OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=documents
SUPABASE_QUERY_NAME=match_documents

# Chat memory + log DB (asyncpg). Prod'da Coolify içindeki chatlogs-db Postgres'i.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Calisma modu: local | prod   (varsayilan: prod)
#   prod  -> normal davranis; DATABASE_URL zorunlu, mesajlar DB'ye yazilir.
#            Coolify'da MODE=prod olarak set edilir.
#   local -> DB'ye hicbir sey yazilmaz; prod verisi kirlenmez.
# Tanimlanmazsa prod kabul edilir; DATABASE_URL eksikse uygulama startup'ta durur.
MODE=local

HISTORY_LIMIT=10
RETRIEVER_K=12
RERANK_TOP_N=8
# Rerank eşiği: bu skorun altındaki chunk LLM'e gitmez. Hiçbiri geçemezse arama BOŞ
# döner — kapsam dışı bir soruya alakasız chunk vermek halüsinasyon yüzeyi açar.
#
# 0.40 ölçüldü: golden.yaml 30 vakada 0.15 ve 0.30 eşiklerinde negatif vakalar
# sızıyordu ("maaş beklentisi" sorusuna Upwork chunk'ı 0.3638 ile geçiyordu),
# 0.40'ta 30/30. Temmuz kalibrasyonu da aynı yeri gösteriyordu: pozitifler ≥0.400.
#
# İsim eski RERANK_MIN_SCORE'dan farklı çünkü .env o satırı 0.3 ile taşıyordu.
RERANK_SCORE_THRESHOLD=0.40
# match_documents RPC'sine geçilen cosine similarity tabanı (0 = kapalı; RPC 4-arg imzayı gerektirir)
MATCH_THRESHOLD=0.0

CHUNK_SIZE=2000
CHUNK_OVERLAP=150

MAX_INPUT_LENGTH=1000
# /chat auth'suz ve halka açık; her istek 2-5 OpenAI + 2-5 Cohere çağrısı demek.
RATE_LIMIT_PER_MIN=20    # IP başına (X-Forwarded-For'un SON elemanı)
RATE_LIMIT_PER_DAY=100   # session_id başına

ADMIN_API_KEY=change-me
ALLOWED_ORIGINS=https://yasinharman.com,https://www.yasinharman.com,http://localhost:5173

PORT=8000
LOG_LEVEL=info
