OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=documents
SUPABASE_QUERY_NAME=match_documents

# Chat memory + log DB (asyncpg). Prod'da Coolify içindeki chatlogs-db Postgres'i.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>

HISTORY_LIMIT=10
RETRIEVER_K=12
RERANK_TOP_N=4
# Cohere rerank skoru bu değerin altındaki chunk'lar LLM'e gitmez (0 = kapalı)
# Eval kalibrasyonu 19.07.2026: negatifler ≤0.225, pozitifler ≥0.400 → 0.3 güvenli ayrım
RERANK_MIN_SCORE=0.3
# match_documents RPC'sine geçilen cosine similarity tabanı (0 = kapalı; RPC 4-arg imzayı gerektirir)
MATCH_THRESHOLD=0.0

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

MAX_INPUT_LENGTH=1000

ADMIN_API_KEY=change-me
ALLOWED_ORIGINS=https://yasinharman.com,https://www.yasinharman.com,http://localhost:5173

PORT=8000
LOG_LEVEL=info
